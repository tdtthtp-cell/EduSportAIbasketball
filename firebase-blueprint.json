{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Hồ sơ thể trạng nhân trắc học và đánh giá thể chất học sinh THPT",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "class": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "enum": ["Nam", "Nữ"] },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "bmi": { "type": "number" },
        "status": { "type": "string", "enum": ["standard", "overweight", "underweight", "mild"] },
        "medicalNote": { "type": "string", "maxLength": 500 },
        "evalTech": { "type": "string", "maxLength": 500 },
        "evalAttitude": { "type": "string", "maxLength": 500 },
        "evalDigital": { "type": "string", "maxLength": 500 },
        "rating": { "type": "string", "maxLength": 50 },
        "parentPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "class", "gender", "heightCm", "weightKg", "bmi", "status"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Danh mục lưu trữ và đồng bộ đám mây toàn bộ hồ sơ học sinh các lớp 10A1, 10A3, 12C1, 12C2, 12C3"
    }
  }
}
